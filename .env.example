# =========================================================================
# ZEEROCODES PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual production credentials.
# NEVER commit the active .env file to Git or public repositories.
# =========================================================================

# Server Configuration
PORT=8080
NODE_ENV=production
SESSION_SECRET=generate_a_64_character_random_hex_string_for_session_signing

# Paystack Payment Gateway (Nigeria / International)
# Live keys obtained from: https://dashboard.paystack.co/#/settings/developer
PAYSTACK_PUBLIC_KEY=pk_live_your_live_paystack_public_key
PAYSTACK_SECRET_KEY=sk_live_your_live_paystack_secret_key

# Flutterwave Payment Gateway (Backup / Multi-Currency)
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_your_flutterwave_public_key
FLUTTERWAVE_SECRET_KEY=FLWSECK_your_flutterwave_secret_key
FLUTTERWAVE_WEBHOOK_SECRET=your_flutterwave_webhook_hash_signature

# Supabase Datastore & Auth (PostgreSQL with RLS)
# Project settings obtained from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJ_your_supabase_public_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJ_your_supabase_server_only_service_role_key

# WhatsApp Business Cloud API & Meta Graph
WHATSAPP_CLOUD_API_TOKEN=EAA_your_meta_system_user_access_token
WHATSAPP_PHONE_NUMBER_ID=109283746519283
WHATSAPP_WEBHOOK_VERIFY_TOKEN=zeerocodes_meta_webhook_challenge_token_2026

# VibeScan AST Scanner Backend
# Local development: http://localhost:3000 | Production: https://vibescan-teal.vercel.app
VIBESCAN_API_URL=http://localhost:3000
VIBESCAN_API_KEY=vbs_live_internal_service_token
